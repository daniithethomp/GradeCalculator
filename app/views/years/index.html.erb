<p style="color: green"><%= notice %></p>
<h3 class="m-1">Years</h3>
<hr>
<div class="d-flex">
  <form class="d-flex me-auto ms-2" role="search">
    <input class="form-control me-2" type="search" placeholder="Search" aria-label="Search"/>
    <button class="btn btn-outline-success" type="submit">Search</button>
  </form>
  <%= link_to "Add Year", new_year_path, class: "btn btn-primary me-2", data: { toggle: 'ajax-modal' } %>
</div>
<div id="years">
  <% if @years.empty? %>
    <p>You have no years. Create a Year to get started.</p>
  <% end %>
  <% @years.each do |year| %>
    <%= link_to year, style: "display:block", class: "module hoverable" do %>
      <%= render year %>
      <div class="score-bar">
        <div class="bar-background">
          <div class="bar" style="width: <%= get_year_score(year).round(2) %>%; background: var(--<%= get_score_colour(get_year_score(year).round(2)) %>-color)">
            <p><%= get_year_score(year).round(2) %>%</p>
          </div>
          <div class="target-mark" style="margin: 0 0 0 <%= current_user.target_score %>%" ></div>
        </div>
      </div>
    <% end %>
  <% end %>
</div>