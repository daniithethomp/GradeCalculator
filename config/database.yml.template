default: &default
  adapter: postgresql
  encoding: unicode
  pool: <%= ENV.fetch("RAILS_MAX_THREADS") { 5 } %>

development:
  <<: *default
  database: grade_calculator_development
  username: your_username
  password: your_password
  host: localhost

test:
  <<: *default
  database: grade_calculator_test
  username: your_username
  password: your_password
  host: localhost

production:
  <<: *default
  database: grade_calculator_production
  username: your_production_username
  password: <%= ENV['DATABASE_PASSWORD'] %>